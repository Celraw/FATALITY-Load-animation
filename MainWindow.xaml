<Window x:Class="FatalityVisual.MainWindow"
        x:Name="IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fatality Visual"
        WindowStartupLocation="Manual"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <CubicEase x:Key="RiseEase" EasingMode="EaseOut" />
        <CubicEase x:Key="SlideEase" EasingMode="EaseInOut" />

        <Storyboard x:Key="IntroStoryboard">
            <!-- The acrylic background is already visible while loading is shown. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoadingText"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.82" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.18" Value="0.82" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.50" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- F: rise into view after the 1.5 second loading phase. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FTranslate"
                                           Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="92" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.50" Value="92" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.20"
                                      Value="0"
                                      EasingFunction="{StaticResource RiseEase}" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FMark"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.50" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.68" Value="0.08" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.12" Value="1" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Once settled, F moves left to make room for the rest of the word. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FTranslate"
                                           Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="228" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.28" Value="228" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.88"
                                      Value="0"
                                      EasingFunction="{StaticResource SlideEase}" />
            </DoubleAnimationUsingKeyFrames>

            <!-- ATALITY rises behind a hard clipping mask for the reveal effect. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RestTranslate"
                                           Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="118" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.58" Value="118" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.40"
                                      Value="0"
                                      EasingFunction="{StaticResource RiseEase}" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RestText"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.58" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.78" Value="0.28" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.32" Value="1" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Hold briefly, fade the complete window, then MainWindow closes it. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IntroWindow"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.75" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:5.22" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid Background="#46030303"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <TextBlock x:Name="LoadingText"
                   Text="Now Loading..."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,2"
                   Foreground="#E8E8E8"
                   FontFamily="Segoe UI"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Opacity="0" />

        <!-- A fixed 520 px wordmark grid makes the visible glyphs, not just the
             clipping canvas, geometrically centered on every screen size. -->
        <Grid Width="520"
              Height="138"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="456" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="FMark"
                  Grid.Column="0"
                  Width="64"
                  Height="138"
                  Opacity="0"
                  RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="FTranslate" X="228" Y="92" />
                </Grid.RenderTransform>
                <Viewbox Width="64" Height="138" Stretch="Fill">
                    <Viewbox.Effect>
                        <DropShadowEffect Color="#B90A14"
                                          BlurRadius="12"
                                          ShadowDepth="0"
                                          Opacity="0.34" />
                    </Viewbox.Effect>
                    <TextBlock Text="F"
                               Foreground="#E20A17"
                               FontFamily="Bahnschrift"
                               FontSize="118"
                               FontWeight="Bold"
                               FontStretch="Condensed"
                               LineHeight="118"
                               LineStackingStrategy="BlockLineHeight" />
                </Viewbox>
            </Grid>

            <Border Grid.Column="1"
                    Width="456"
                    Height="138"
                    Background="Transparent"
                    ClipToBounds="True">
                <Grid x:Name="RestText"
                      Width="456"
                      Height="138"
                      Opacity="0"
                      RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="RestTranslate" Y="118" />
                    </Grid.RenderTransform>
                    <Viewbox Width="456" Height="138" Stretch="Fill">
                        <Viewbox.Effect>
                            <DropShadowEffect Color="#B90A14"
                                              BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.34" />
                        </Viewbox.Effect>
                        <TextBlock Text="ATALITY"
                                   Foreground="#E20A17"
                                   FontFamily="Bahnschrift"
                                   FontSize="118"
                                   FontWeight="Bold"
                                   FontStretch="Condensed"
                                   LineHeight="118"
                                   LineStackingStrategy="BlockLineHeight" />
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
